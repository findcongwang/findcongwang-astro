{
  "$ref": "#/definitions/domains",
  "definitions": {
    "domains": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "note",
            "source",
            "person"
          ],
          "default": "note"
        },
        "status": {
          "type": "string",
          "enum": [
            "private",
            "seed",
            "wip",
            "ready",
            "published",
            "unlisted"
          ],
          "default": "wip"
        },
        "publish_type": {
          "type": "string",
          "enum": [
            "blog",
            "paper",
            "domain",
            "lexicon",
            "influence",
            "book",
            "project"
          ]
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "created_date": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "integer",
              "format": "unix-time"
            }
          ]
        },
        "publish_date": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "integer",
              "format": "unix-time"
            }
          ]
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string",
          "default": ""
        },
        "author": {
          "type": "string",
          "default": "Francis Wang"
        },
        "$schema": {
          "type": "string"
        }
      },
      "required": [
        "publish_type",
        "created_date",
        "title"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}