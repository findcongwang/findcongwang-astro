{
  "$ref": "#/definitions/projects",
  "definitions": {
    "projects": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "atom",
            "note",
            "source",
            "person"
          ],
          "default": "note"
        },
        "status": {
          "type": "string",
          "enum": [
            "private",
            "seed",
            "wip",
            "ready",
            "published",
            "unlisted"
          ],
          "default": "wip"
        },
        "publish_type": {
          "type": "string",
          "enum": [
            "atom",
            "blog",
            "essay",
            "paper",
            "domain",
            "lexicon",
            "influence",
            "book",
            "project",
            "question",
            "challenge"
          ]
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "created_date": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "integer",
              "format": "unix-time"
            }
          ]
        },
        "originated_date": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "integer",
              "format": "unix-time"
            }
          ]
        },
        "publish_date": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "integer",
              "format": "unix-time"
            }
          ]
        },
        "updated_date": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "integer",
              "format": "unix-time"
            }
          ]
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string",
          "default": ""
        },
        "author": {
          "type": "string",
          "default": "Francis Wang"
        },
        "syndicated_to": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "site": {
                "type": "string"
              },
              "collection": {
                "type": "string"
              },
              "slug": {
                "type": "string"
              },
              "last_synced": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date-time"
                  },
                  {
                    "type": "string",
                    "format": "date"
                  },
                  {
                    "type": "integer",
                    "format": "unix-time"
                  }
                ]
              }
            },
            "required": [
              "site",
              "collection",
              "slug",
              "last_synced"
            ],
            "additionalProperties": false
          }
        },
        "canonical_url": {
          "type": "string",
          "format": "uri"
        },
        "$schema": {
          "type": "string"
        }
      },
      "required": [
        "publish_type",
        "title"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}