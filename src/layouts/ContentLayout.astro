---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import ShareButtons from "@/components/fundations/elements/ShareButtons.astro";
import ContentEntry from "@/components/content/ContentEntry.astro";
import {
  getListableEntries,
  entryHref,
  type ContentCollectionId,
} from "@/utils/content";

const { frontmatter, collection, backHref } = Astro.props;
const title = "title" in frontmatter ? frontmatter.title : "";
const description = "description" in frontmatter ? frontmatter.description : "";
const publishDate =
  "publish_date" in frontmatter && frontmatter.publish_date
    ? new Date(frontmatter.publish_date)
    : null;
const tags = "tags" in frontmatter ? (frontmatter.tags ?? []) : [];

const contentCollections: ContentCollectionId[] = [
  "posts",
  "domains",
  "lexicon",
  "influences",
  "projects",
];
const currentSlug = Astro.url.pathname.split("/").filter(Boolean).pop() ?? "";
interface RelatedItem {
  collection: ContentCollectionId;
  entry: { slug: string; data: Record<string, unknown> };
}
const relatedWithCollection: RelatedItem[] = [];
for (const col of contentCollections) {
  const entries = await getListableEntries(col as ContentCollectionId) as { slug: string; data: Record<string, unknown> }[];
  for (const e of entries) {
    if (e.slug === currentSlug && col === collection) continue;
    const eTags = (e.data.tags as string[] | undefined) ?? [];
    if (tags.some((t: string) => eTags.includes(t)))
      relatedWithCollection.push({ collection: col, entry: { slug: e.slug, data: e.data } });
  }
}
const related = relatedWithCollection.slice(0, 3);
---

<BaseLayout>
  <section>
    <Wrapper variant="standard" class="pt-24 pb-12 lg:pt-48">
      {backHref && (
        <a
          href={backHref}
          class="flex items-center text-xs text-primary hover:text-primary/60 gap-2"
        >
          <span aria-hidden="true">←</span>
          Back
        </a>
      )}
      <div class="mt-12 grid gap-4 lg:gap-8 grid-cols-1 lg:grid-cols-3 lg:items-start">
        <div class="text-balance lg:col-span-2">
          <Text tag="h1" variant="textBase" class="text-primary">
            {title}
          </Text>
          {description && (
            <Text
              tag="p"
              variant="textSM"
              class="font-serif text-primary/60 text-balance"
            >
              {description}
            </Text>
          )}
          <div class="prose-ul:text-zinc-500 prose prose-xs prose-headings:font-sans font-serif max-w-none pt-0 prose-a:text-black prose-p:text-zinc-500 prose-code:text-black prose-strong:text-black prose-ol:text-zinc-500 prose-headings:text-black prose-headings:text-base text-sm mt-4 w-full">
            <slot />
          </div>
        </div>

        <div class="lg:sticky lg:top-24">
          <div class="space-y-4">
            {publishDate && (
              <div>
                <Text tag="p" variant="textXS" class="text-primary/60">
                  <time datetime={publishDate.toISOString()}>
                    {publishDate.toLocaleDateString("en-US", {
                      year: "numeric",
                      month: "long",
                      day: "2-digit",
                    })}
                  </time>
                </Text>
              </div>
            )}
            {tags.length > 0 && (
              <div>
                <Text tag="p" variant="textXS" class="text-primary/60">
                  Tags: {tags.join(", ")}
                </Text>
              </div>
            )}
            <div class="relative flex flex-wrap pt-2 mt-2 border-t border-dotted border-primary/10 gap-2">
              <ShareButtons description={description} />
            </div>
          </div>
        </div>
      </div>
    </Wrapper>
  </section>
  {related.length > 0 && (
    <section>
      <Wrapper variant="standard" class="py-12">
        <Text tag="h2" variant="textBase" class="text-primary">
          Related
        </Text>
        <div class="flex flex-col pt-2 mt-2 border-t border-dotted gap-2 border-primary/10">
          {related.map(({ collection: col, entry: e }) => (
            <ContentEntry
              entry={{ slug: e.slug, data: e.data }}
              href={entryHref(col, e.slug)}
            />
          ))}
        </div>
      </Wrapper>
    </section>
  )}
</BaseLayout>
