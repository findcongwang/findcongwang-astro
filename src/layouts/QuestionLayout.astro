---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import ShareButtons from "@/components/fundations/elements/ShareButtons.astro";
import ContentEntry from "@/components/content/ContentEntry.astro";
import MermaidRenderer from "@/components/fundations/scripts/MermaidRenderer.astro";
import PagedViewer from "@/components/paged/PagedViewer.astro";
import AnnotationPanel from "@/components/annotations/AnnotationPanel.astro";
import RoughAnnotation from "@/components/annotations/RoughAnnotation.astro";
import {
  getListableEntries,
  entryHref,
  PUBLISH_TYPE_LABELS,
  COLLECTION_TO_PUBLISH_TYPE,
  type ContentCollectionId,
} from "@/utils/content";
import { DEFAULT_PRINT_FORMAT, isPrintFormatKey, isPrintSpreadStart } from "@/data/print-formats";

interface Props {
  frontmatter: Record<string, unknown>;
  collection: ContentCollectionId;
  backHref?: string;
  body?: string;
}
const { frontmatter, collection, backHref, body } = Astro.props as Props;

// Standard fields
const title = "title" in frontmatter ? (frontmatter.title as string) : "";
const description = "description" in frontmatter ? (frontmatter.description as string) : "";
const author = (frontmatter.author as string) ?? "Francis Wang";

// Question-specific fields
const domainTheme = "domain_theme" in frontmatter ? (frontmatter.domain_theme as string) : "";
const boldAmbitionRaw = "bold_ambition" in frontmatter ? (frontmatter.bold_ambition as string) : "";
const constraintsRaw = "constraints" in frontmatter ? frontmatter.constraints : [];
const constraints: string[] = Array.isArray(constraintsRaw) ? constraintsRaw as string[] : [];

/** Capitalize first letter of a string */
function cap(s: string): string {
  return s.charAt(0).toUpperCase() + s.slice(1);
}
const boldAmbition = boldAmbitionRaw ? cap(boldAmbitionRaw) : "";

// Dates
const publishDate =
  "publish_date" in frontmatter && frontmatter.publish_date
    ? new Date(frontmatter.publish_date as string | number | Date)
    : null;
const originatedDate =
  "originated_date" in frontmatter && frontmatter.originated_date
    ? new Date(frontmatter.originated_date as string | number | Date)
    : null;
const updatedDate =
  "updated_date" in frontmatter && frontmatter.updated_date
    ? new Date(frontmatter.updated_date as string | number | Date)
    : null;
const displayDate = originatedDate ?? publishDate ??
  ("created_date" in frontmatter && frontmatter.created_date
    ? new Date(frontmatter.created_date as string | number | Date)
    : null);
const secondaryDate = updatedDate ?? (publishDate && originatedDate && publishDate.getTime() !== originatedDate.getTime() ? publishDate : null);

const tags = "tags" in frontmatter ? ((frontmatter.tags as string[]) ?? []) : [];

// Print format resolution
const printFormat =
  typeof frontmatter.print_format === "string" && isPrintFormatKey(frontmatter.print_format)
    ? frontmatter.print_format
    : DEFAULT_PRINT_FORMAT;
const printMode =
  frontmatter.print_mode === "digital" || frontmatter.print_mode === "physical"
    ? frontmatter.print_mode
    : "physical";
const printAnnotations =
  typeof frontmatter.print_annotations === "boolean" ? String(frontmatter.print_annotations) : "";
const printSpreadStart =
  typeof frontmatter.print_spread_start === "string" && isPrintSpreadStart(frontmatter.print_spread_start)
    ? frontmatter.print_spread_start
    : "odd";
const printLink =
  printFormat === DEFAULT_PRINT_FORMAT
    ? "?format=print"
    : `?format=print&size=${encodeURIComponent(printFormat)}`;
const printLinkWithMode =
  printMode === "digital" ? `${printLink}&mode=digital` : printLink;
const printLinkFull =
  printSpreadStart !== "odd" ? `${printLinkWithMode}&spread=${printSpreadStart}` : printLinkWithMode;

// Meta
const site = import.meta.env.SITE ?? "https://findcongwang.com";
const pathname = Astro.url.pathname.replace(/\/?$/, "") || "";
const canonical = `${site}${pathname}`;
const metaDescription = description || (title ? `${title} — Francis Wang's personal website.` : undefined);

// Reading time
const wordCount =
  typeof body === "string"
    ? body
        .replace(/```[\s\S]*?```/g, " ")
        .replace(/\[([^\]]*)\]\([^)]*\)/g, "$1")
        .replace(/[#*_~`<>]/g, " ")
        .split(/\s+/)
        .filter(Boolean).length
    : 0;
const readMinutes = wordCount > 0 ? Math.max(1, Math.round(wordCount / 200)) : 0;
const tagBasePath = "/browse";

// Related items (same logic as ContentLayout)
const contentCollections: ContentCollectionId[] = [
  "posts",
  "domains",
  "lexicon",
  "influences",
  "projects",
  "questions",
  "challenges",
];
const currentSlug = Astro.url.pathname.split("/").filter(Boolean).pop() ?? "";
interface RelatedItem {
  collection: ContentCollectionId;
  entry: { slug: string; data: Record<string, unknown> };
}
const relatedWithCollection: RelatedItem[] = [];
for (const col of contentCollections) {
  const entries = await getListableEntries(col as ContentCollectionId) as { slug: string; data: Record<string, unknown> }[];
  for (const e of entries) {
    if (e.slug === currentSlug && col === collection) continue;
    const eTags = (e.data.tags as string[] | undefined) ?? [];
    if (tags.some((t: string) => eTags.includes(t)))
      relatedWithCollection.push({ collection: col, entry: { slug: e.slug, data: e.data } });
  }
}
const related = relatedWithCollection.slice(0, 3);
---

<BaseLayout title={title} description={metaDescription} canonical={canonical}>
    <Wrapper variant="standard" class="pt-24 pb-12 lg:pt-48">
      {backHref && (
        <a
          href={backHref}
          class="flex items-center text-xs text-primary hover:text-primary/60 gap-2"
        >
          <span aria-hidden="true">&larr;</span>
          Back
        </a>
      )}
      <div class="mt-12 flex flex-col gap-4">
        <div class="text-balance">

          {/* ─── Title + Meta ─── */}
          <span class="relative inline-block mb-2">
            <RoughAnnotation palette="brand" color="question" type="highlight">
              <span class="text-xs font-semibold text-primary">
                Question
              </span>
            </RoughAnnotation>
          </span>
          <Text tag="h1" variant="textBase" class="text-primary">
            {title}
          </Text>
          {description && (
            <Text
              tag="p"
              variant="textSM"
              class="font-serif text-primary/60 text-balance"
            >
              {description}
            </Text>
          )}
          <div class="flex flex-wrap items-center gap-x-3 gap-y-1 mt-2 text-xs text-primary/60 ">
            {author && (
              <>
                <span>By {author === "Francis Wang" ? (<a href="/curriculum-vitae" class="hover:text-primary underline underline-offset-2">{author}</a>) : author}</span>
                {(displayDate || tags.length > 0 || readMinutes > 0) && <span aria-hidden="true">&middot;</span>}
              </>
            )}
            {displayDate && (
              <span>
                Originated: <time datetime={displayDate.toISOString().slice(0, 10)}>
                  {displayDate.toLocaleDateString("en-US", {
                    year: "numeric",
                    month: "short",
                    day: "2-digit",
                    timeZone: "UTC",
                  })}
                </time>
              </span>
            )}
            {secondaryDate && (
              <>
                <span aria-hidden="true">&middot;</span>
                <span>
                  Updated: <time datetime={secondaryDate.toISOString().slice(0, 10)}>
                    {secondaryDate.toLocaleDateString("en-US", {
                      year: "numeric",
                      month: "short",
                      day: "2-digit",
                      timeZone: "UTC",
                    })}
                  </time>
                </span>
              </>
            )}
            {readMinutes > 0 && (
              <>
                {(displayDate ?? tags.length > 0) && <span aria-hidden="true">&middot;</span>}
                <span>{readMinutes} min read</span>
              </>
            )}
            {tags.length > 0 && (
              <>
                {displayDate && <span aria-hidden="true">&middot;</span>}
                <span class="flex flex-wrap items-center gap-x-1.5 gap-y-0">
                  {tags.map((tag) => (
                    <a
                      href={`${tagBasePath}?tags=${encodeURIComponent(tag)}`}
                      class="hover:text-primary underline underline-offset-2"
                    >
                      {tag}
                    </a>
                  ))}
                </span>
              </>
            )}
          </div>
          {frontmatter.formats && (frontmatter.formats as string[]).length > 0 && (
            <div class="flex items-center gap-3 mt-2 text-xs text-primary/40">
              <span>Alternative formats:</span>
              {(frontmatter.formats as string[]).includes("print") && (
                <a href={printLinkFull} class="hover:text-primary underline underline-offset-2" target="_blank">Print</a>
              )}
            </div>
          )}
          <div class="border-b border-dotted border-primary/10">
            <br>
          </div>
          <div
            id="print-config"
            class="hidden"
            data-print-format={printFormat}
            data-print-mode={printMode}
            data-print-spread-start={printSpreadStart}
            {...(printAnnotations ? { "data-print-annotations": printAnnotations } : {})}
          ></div>
          <div id="paged-content" class="article-body">
          {boldAmbition && (
            <div class="question-hero my-8 flex flex-col gap-5 max-w-xl">
              {/* How might we */}
              <p class="question-hero__label text-xs uppercase tracking-widest text-primary/40 font-sans mb-0">
                How might we
              </p>
              
              {/* Bold ambition + ", without" appended */}
              <p class="question-hero__ambition text-base sm:text-lg md:text-xl lg:text-xl font-serif text-balance">
                <span style="color: #0c899e;">{boldAmbition}</span>{"\u00A0"}<span class="question-hero__separator text-[15px] text-primary/60 font-sans">, without</span>
              </p>
              <span class="question-hero__caption text-[10px] text-primary/30 italic font-sans -mt-4">
                (bold ambition)
              </span>

              {/* Constraints — each on its own line, ", and" trails the constraint */}
              <div class="question-hero__constraints flex flex-col gap-1">
                {constraints.map((constraint: string, index: number) => (
                  <p class="question-hero__constraint text-base sm:text-lg md:text-xl lg:text-xl font-serif text-balance mb-0">
                    <span style="color: #d54021;">{cap(constraint)}</span>{index === constraints.length - 1 ? <span style="color: #d54021;">?</span> : <>{"\u00A0"}<span class="question-hero__separator text-[15px] text-primary/60 font-sans">, and</span></>}
                  </p>
                ))}
              </div>

              <span class="question-hero__caption text-[10px] text-primary/30 italic font-sans -mt-3">
                (significant constraints)
              </span>
            </div>
          )}

          {/* ─── Body Content ─── */}
          <div class="prose-ul:text-zinc-500 prose prose-xs prose-headings:font-sans font-serif max-w-none pt-0 leading-relaxed prose-a:text-zinc-500 hover:prose-a:text-zinc-700 prose-p:text-zinc-500 prose-code:text-black prose-strong:text-black prose-ol:text-zinc-500 prose-headings:text-black prose-headings:text-base text-sm mt-4 w-full [&_.rough-annotation]:text-inherit [&_.rough-annotation]:font-inherit">
            <slot />
          </div>
          </div>
          <PagedViewer
            title={title}
            subtitle={description}
            author={author}
            date={displayDate?.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" })}
            type="Question"
          />
        </div>
        <div class="mt-8 pt-6 border-t border-dotted border-primary/10">
          <div class="relative flex flex-wrap gap-2">
            <ShareButtons description={description} />
          </div>
        </div>
      </div>
    </Wrapper>
  </section>
  {related.length > 0 && (
    <section>
      <Wrapper variant="standard" class="py-12">
        <Text tag="h2" variant="textBase" class="text-primary">
          Related
        </Text>
        <div class="flex flex-col pt-2 mt-2 border-t border-dotted gap-2 border-primary/10">
          {related.map(({ collection: col, entry: e }) => (
            <ContentEntry
              entry={{ slug: e.slug, data: e.data }}
              href={entryHref(col, e.slug)}
              collection={col}
              publishType={typeof e.data.publish_type === "string" ? e.data.publish_type : undefined}
            />
          ))}
        </div>
      </Wrapper>
    </section>
  )}
<MermaidRenderer />
<AnnotationPanel />
</BaseLayout>
