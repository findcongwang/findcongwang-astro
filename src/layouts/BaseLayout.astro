---
// Foundations
import "@/styles/global.css";
import BaseHead from "@/components/fundations/head/BaseHead.astro";
// Components
import Footer from "@/components/global/Footer.astro";
import Navigation from "@/components/global/Navigation.astro";
// Components
// Hides nav and footer on selected screens by passing
// the hideNav and hideFooter props
// <BaseLayout hideNav={true} hideFooter={true}>
// Optional SEO: title, description, canonical, noindex, image (for OG/Twitter)
const { hideNav = false, hideFooter = false, title, description, canonical, noindex, image } = Astro.props;
// Scripts
import ToggleScript from "@/components/fundations/scripts/ToggleScript.astro";
import RoughNotationHighlight from "@/components/fundations/scripts/RoughNotationHighlight.astro";
---
<html
  lang="en"
  class="scroll-smooth selection:bg-accent selection:text-secondary"
>
  <head>
    <BaseHead title={title} description={description} canonical={canonical} noindex={noindex} image={image} />
  </head>
  <body class="relative flex flex-col bg-secondary min-h-svh">
    {!hideNav && <Navigation />}
    <main class="grow">
      <slot />
    </main>
    {!hideFooter && <Footer />}
      <ToggleScript />
      <RoughNotationHighlight />
  </body>
</html>
