---
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";

const cards = [
  {
    title: "Research",
    slug: "research",
    subtitle:
      "Compelling questions and innovation challenges exploring the boundaries of what's possible.",
  },
  {
    title: "Influences",
    slug: "influences",
    subtitle:
      "People and resources that influenced my thinking, tagged by domain with my reflections.",
  },
  {
    title: "Lexicon",
    slug: "lexicon",
    subtitle:
      "Lexicon is my personal dictionary of key terms, concepts, and distinctions that I use in my work.",
  },
  {
    title: "Blog Posts, Essays, Books, and Projects",
    slug: "posts",
    subtitle:
      "Different modes of my intellectual output, organized by domain, short/long-form, interactive/static, etc.",
  },
];
---

<section>
  <Wrapper variant="standard" class="py-12">
    <Text tag="h2" variant="textBase" class="font-medium text-primary">
      How to Navigate This Site
    </Text>
    <Text
      tag="p"
      variant="textBase"
      class="font-serif text-primary/60 text-balance"
    >
      I try to structurally reflect on my influences to inform my domains of understanding, then write out my perspectives in different modes.
    </Text>
    <div
      class="pt-2 mt-2 border-t border-dotted grid gap-8 md:grid-cols-2 border-primary/10 text-balance"
    >
      {
        cards.map((card) => (
          <div>
            <h3 class="relative inline-block text-sm font-semibold text-primary">
              <span data-rough-highlight={card.slug}>
                {card.title}
              </span>
            </h3>
            <Text
              tag="p"
              variant="textSM"
              class="mt-1 font-serif text-primary/60"
            >
              {card.subtitle}
            </Text>
          </div>
        ))
      }
    </div>
  </Wrapper>
</section>

