---
/**
 * Rough Notation for any page on the site.
 *
 * Single element (site convention):
 *   data-rough-highlight="<key>"  — color key: primary, yellow, bet, or publish type (atom, blog, essay, paper, domain, lexicon, influence, book, project)
 *   data-rough-type="<type>"      — optional: highlight (default), box, circle, bracket, underline
 *
 * Obsidian-synced convention (data-rough + data-rough-color):
 *   data-rough="<type>"           — highlight, box, circle, bracket, underline
 *   data-rough-color="<key>"      — same color keys as above
 *   data-rough-bracket="left,right" or data-rough-brackets="left"|"right" — bracket sides
 *
 * Block content: wrap in data-rough-annotate="<key>"; children (p, blockquote, li) get that color.
 */
---

<script>
  import { annotate } from "rough-notation";

  type AnnotationType = "highlight" | "box" | "circle" | "bracket" | "underline";

  const PRIMARY_COLOR = "#660005";
  const PRIMARY_HIGHLIGHT = "rgba(102, 0, 5, 0.25)";
  /** Standard highlighter yellow, 50% transparency */
  const HIGHLIGHTER_YELLOW = "rgba(255, 255, 0, 0.5)";

  /** Publish-type and collection-slug highlight colors. Collection slugs (domains, influences, lexicon, posts) map to same as singular types. */
  /** Five major domain keys for Hero/labels: domain-dfs, domain-bet, domain-lkm, domain-hfl, domain-sdev. */
  const HIGHLIGHT_COLORS: Record<string, string> = {
    primary: PRIMARY_HIGHLIGHT,
    yellow: HIGHLIGHTER_YELLOW,
    bet: PRIMARY_HIGHLIGHT,
    atom: "rgba(125, 132, 145, 0.3)",
    blog: "rgba(125, 132, 145, 0.3)",
    essay: "rgba(125, 132, 145, 0.3)",
    paper: "rgba(125, 132, 145, 0.3)",
    domain: "rgba(109, 104, 117, 0.3)",
    domains: "rgba(109, 104, 117, 0.3)",
    lexicon: "rgba(138, 154, 91, 0.3)",
    influence: "rgba(212, 163, 115, 0.3)",
    influences: "rgba(212, 163, 115, 0.3)",
    book: "rgba(74, 111, 165, 0.3)",
    project: "rgba(194, 139, 46, 0.3)",
    posts: "rgba(125, 132, 145, 0.3)",
    "domain-dfs": "rgba(82, 58, 120, 0.12)",
    "domain-bet": "rgba(102, 0, 5, 0.12)",
    "domain-lkm": "rgba(163, 92, 46, 0.12)",
    "domain-hfl": "rgba(33, 85, 122, 0.12)",
    "domain-sdev": "rgba(16, 71, 71, 0.12)",
  };

  const STROKE_COLORS: Record<string, string> = {
    primary: PRIMARY_COLOR,
    yellow: "rgb(200, 180, 0)",
    bet: PRIMARY_COLOR,
    atom: "rgb(125, 132, 145)",
    blog: "rgb(125, 132, 145)",
    essay: "rgb(125, 132, 145)",
    paper: "rgb(125, 132, 145)",
    domain: "rgb(109, 104, 117)",
    domains: "rgb(109, 104, 117)",
    lexicon: "rgb(138, 154, 91)",
    influence: "rgb(212, 163, 115)",
    influences: "rgb(212, 163, 115)",
    book: "rgb(74, 111, 165)",
    project: "rgb(194, 139, 46)",
    posts: "rgb(125, 132, 145)",
    "domain-dfs": "#523A78",
    "domain-bet": "#660005",
    "domain-lkm": "#A35C2E",
    "domain-hfl": "#21557A",
    "domain-sdev": "#104747",
  };

  function getColor(key: string | null, forStroke: boolean): string {
    const map = forStroke ? STROKE_COLORS : HIGHLIGHT_COLORS;
    return (key && map[key]) || map.primary;
  }

  function getType(el: HTMLElement): AnnotationType {
    const fromRough = el.getAttribute("data-rough");
    const fromType = el.getAttribute("data-rough-type");
    const t = fromType || fromRough;
    if (t === "box" || t === "circle" || t === "highlight" || t === "bracket" || t === "underline") return t;
    return "highlight";
  }

  function getBrackets(el: HTMLElement): ("left" | "right")[] {
    const raw = el.getAttribute("data-rough-brackets") ?? el.getAttribute("data-rough-bracket");
    if (!raw) return ["left", "right"];
    const parts = raw.split(",").map((s) => s.trim().toLowerCase());
    const out: ("left" | "right")[] = [];
    if (parts.includes("left")) out.push("left");
    if (parts.includes("right")) out.push("right");
    return out.length ? out : ["left", "right"];
  }

  function annotateElement(el: HTMLElement, colorKey: string | null) {
    const type = getType(el);
    const isHighlight = type === "highlight";
    const color = getColor(colorKey, !isHighlight);
    const options: Parameters<typeof annotate>[1] = {
      type,
      color,
      strokeWidth: 1.0,
      animate: true,
      animationDuration: 400,
      padding: 8,
      ...(type === "highlight" && { multiline: true }),
    };
    if (type === "bracket") {
      options.brackets = getBrackets(el);
    }
    const annotation = annotate(el, options);
    annotation.show();
  }

  /** Check if an element is currently visible (not hidden or inside a hidden parent) */
  function isVisible(el: HTMLElement): boolean {
    return el.offsetParent !== null || el.getClientRects().length > 0;
  }

  /** Remove any existing rough-notation SVG annotations from an element.
   *  rough-notation wraps the element in a <span style="display:inline-block;position:relative">
   *  and appends an <svg> inside that wrapper span. */
  function clearAnnotation(el: HTMLElement) {
    const parent = el.parentElement;
    if (parent) {
      // Find and remove any SVGs that rough-notation may have added as siblings
      parent.querySelectorAll(":scope > svg").forEach((svg) => svg.remove());
    }
    delete el.dataset.roughAnnotated;
  }

  function initHighlights() {
    document.querySelectorAll("[data-rough-highlight]").forEach((el) => {
      if (!(el instanceof HTMLElement)) return;
      if (!isVisible(el)) return;
      if (el.dataset.roughAnnotated) return;
      annotateElement(el, el.getAttribute("data-rough-highlight"));
      el.dataset.roughAnnotated = "true";
    });

    document.querySelectorAll("[data-rough]").forEach((el) => {
      if (!(el instanceof HTMLElement)) return;
      if (!isVisible(el)) return;
      if (el.dataset.roughAnnotated) return;
      const colorKey = el.getAttribute("data-rough-color");
      annotateElement(el, colorKey);
      el.dataset.roughAnnotated = "true";
    });

    const annotateSelector = "p, blockquote, li";
    document.querySelectorAll("[data-rough-annotate]").forEach((container) => {
      if (!(container instanceof HTMLElement)) return;
      const key = container.getAttribute("data-rough-annotate");
      container.querySelectorAll(annotateSelector).forEach((child) => {
        if (!(child instanceof HTMLElement)) return;
        if (!isVisible(child)) return;
        if (child.dataset.roughAnnotated) return;
        if (child.hasAttribute("data-rough-highlight") || child.hasAttribute("data-rough")) return;
        annotateElement(child, key);
        child.dataset.roughAnnotated = "true";
      });
    });
  }

  /** On page change: clear annotations on now-hidden elements, then annotate newly visible ones */
  function refreshAnnotations() {
    // Clear annotations on elements that are now hidden
    document.querySelectorAll("[data-rough-annotated]").forEach((el) => {
      if (!(el instanceof HTMLElement)) return;
      if (!isVisible(el)) {
        clearAnnotation(el);
      }
    });
    // Annotate newly visible elements
    initHighlights();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initHighlights);
  } else {
    initHighlights();
  }

  // Re-annotate when pagination or filtering reveals new elements
  document.addEventListener("filterable:page-change", () => {
    // Small delay to let DOM updates settle (hidden class toggling)
    requestAnimationFrame(refreshAnnotations);
  });
</script>
