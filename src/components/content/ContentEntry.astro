---
import { COLLECTION_LABELS, type ContentCollectionId } from "@/utils/content";

interface Props {
  entry: { slug: string; data: Record<string, unknown> };
  href: string;
  showPubDate?: boolean;
  collection?: ContentCollectionId;
}
const { entry, href, showPubDate = true, collection } = Astro.props as Props;
const { slug, data } = entry;
const title = "title" in data ? data.title : "";
const description = "description" in data ? data.description : "";
const publishDate =
  showPubDate && "publish_date" in data && data.publish_date
    ? new Date(data.publish_date)
    : null;
---

<div class="relative flex flex-col md:flex-row items-start gap-4">
  <a
    href={href}
    aria-label={`View: ${title}`}
    title={`View: ${title}`}
    class="absolute inset-0 z-10"
  />
  <div class="min-w-0 flex flex-col gap-0">
    <div class="flex flex-wrap items-center gap-x-2 gap-y-0">
      {collection && (
        <span class="relative inline-block shrink-0">
          <span
            class="text-[10px] font-semibold uppercase tracking-wide text-primary"
            data-rough-highlight={collection}
          >
            {COLLECTION_LABELS[collection]}
          </span>
        </span>
      )}
      <span class="text-primary font-medium">
        {title}
        {showPubDate && publishDate && (
          <span class="ml-2 text-primary/50">({publishDate.getUTCFullYear()})</span>
        )}
      </span>
    </div>
    {description && (
      <p class="mt-1 font-serif text-primary/60 text-balance text-sm">
        {description}
      </p>
    )}
  </div>
</div>
