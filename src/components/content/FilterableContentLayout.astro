---
import Text from "@/components/fundations/elements/Text.astro";
import ContentEntry from "@/components/content/ContentEntry.astro";
import {
  entryHref,
  COLLECTION_LABELS,
  CONTENT_COLLECTIONS,
  type ContentCollectionId,
} from "@/utils/content";

export interface IndexEntry {
  slug: string;
  collection: ContentCollectionId;
  publishType: string;
  title: string;
  description: string;
  tags: string[];
  publishDate: string | null;
  id?: string;
}

interface Props {
  entries: IndexEntry[];
  title: string;
  description: string;
  initialTags?: string[];
  /** When true, show collection checkboxes and filter by collection (browse mode). */
  showCollectionFilters?: boolean;
  defaultSort?: "date-desc" | "date-asc" | "name";
}

const { entries, title, description, initialTags = [], showCollectionFilters = false, defaultSort = "date-desc" } = Astro.props;
const allTags = [...new Set(entries.flatMap((e) => e.tags))].sort();
const serialized = JSON.stringify(
  entries.map((e) => ({
    slug: e.slug,
    collection: e.collection,
    publishType: e.publishType,
    title: e.title,
    description: e.description,
    tags: e.tags,
    publishDate: e.publishDate,
    id: e.id,
  }))
);
const tagsJson = JSON.stringify(allTags);
const collectionIdsJson = JSON.stringify(CONTENT_COLLECTIONS);
const collectionLabelsJson = JSON.stringify(COLLECTION_LABELS);
const initialTagsJson = JSON.stringify(initialTags);
---

<div
  class="filterable-content grid grid-cols-1 md:grid-cols-[1fr_minmax(0,14rem)] gap-8"
  data-initial-tags={initialTagsJson}
  data-show-collection-filters={showCollectionFilters}
>
  <aside class="filterable-sidebar order-2 lg:order-2" aria-label="Filter by tags">
    <Text tag="h2" variant="textSM" class="font-medium text-primary mb-2">
      Tags
    </Text>
    <div
      id="filterable-active-tags"
      class="flex flex-wrap gap-1.5 mb-3 min-h-[1.5rem]"
      role="list"
      aria-label="Active tag filters"
    >
      <!-- Pills injected by script -->
    </div>
    <input
      type="search"
      id="filterable-tag-search"
      placeholder="Filter tags…"
      class="w-full rounded border border-primary/20 bg-secondary px-2 py-1 text-xs text-primary placeholder:text-primary/50 focus:outline-none focus:ring-2 focus:ring-accent mb-2"
      aria-label="Filter tags"
    />
    <div
      id="filterable-tag-ranges"
      class="flex flex-wrap gap-1 mb-2"
      role="group"
      aria-label="Filter tags by letter"
    >
      <!-- Range buttons injected by script -->
    </div>
    <div
      id="filterable-tag-list"
      class="flex flex-col gap-0.5 leading-tight"
      role="list"
    >
      <!-- Tag buttons injected by script -->
    </div>
    <p id="filterable-tag-empty" class="hidden text-xs text-primary/50 py-1">
      No tags match.
    </p>
    <div
      id="filterable-tag-pagination"
      class="mt-2 flex items-center justify-between gap-2 text-xs text-primary/70"
      hidden
    >
      <button
        type="button"
        id="filterable-tag-prev"
        class="rounded px-3 py-1.5 hover:bg-primary/10 disabled:opacity-40 disabled:cursor-not-allowed"
        aria-label="Previous page of tags"
      >
        Prev
      </button>
      <span id="filterable-tag-page-status" aria-live="polite"></span>
      <button
        type="button"
        id="filterable-tag-next"
        class="rounded px-3 py-1.5 hover:bg-primary/10 disabled:opacity-40 disabled:cursor-not-allowed"
        aria-label="Next page of tags"
      >
        Next
      </button>
    </div>
  </aside>

  <div class="filterable-main order-1 lg:order-1 min-w-0">
    {title && (
      <Text tag="h1" variant="textBase" class="text-primary">
        {title}
      </Text>
    )}
    {description && (
      <Text
        tag="p"
        variant="textBase"
        class="font-serif text-primary/60 text-balance mt-2"
      >
        {description}
      </Text>
    )}

    {showCollectionFilters && (
      <div class="mt-3 flex flex-wrap items-center gap-3" role="group" aria-label="Include in list">
        {CONTENT_COLLECTIONS.map((id) => (
          <label class="inline-flex items-center gap-1.5 text-sm text-primary/80 cursor-pointer">
            <input
              type="checkbox"
              class="filterable-collection-checkbox rounded border-primary/30 text-accent focus:ring-accent"
              data-collection-id={id}
              checked
            />
            <span>{COLLECTION_LABELS[id]}</span>
          </label>
        ))}
      </div>
    )}

    <div class="mt-4 flex items-center gap-2">
      <div class="relative flex-1">
        <input
          type="search"
          id="filterable-search"
          placeholder="Search or add tag filter…"
          class="w-full rounded border border-primary/20 bg-secondary px-2 py-1 text-xs text-primary placeholder:text-primary/50 focus:outline-none focus:ring-2 focus:ring-accent"
          aria-label="Search"
          aria-autocomplete="list"
          aria-controls="filterable-search-suggestions"
          aria-expanded="false"
        />
        <ul
          id="filterable-search-suggestions"
          class="absolute top-full left-0 right-0 mt-1 py-1 bg-secondary border border-primary/20 rounded shadow-lg z-10 hidden max-h-60 overflow-y-auto"
          role="listbox"
          aria-label="Search and tag suggestions"
        >
          <!-- Injected by script -->
        </ul>
      </div>
      <select
        id="filterable-sort"
        class="rounded border border-primary/20 bg-secondary px-2 py-1 text-xs text-primary focus:outline-none focus:ring-2 focus:ring-accent"
        aria-label="Sort by"
      >
        <option value="date-desc" selected={defaultSort === "date-desc"}>Newest first</option>
        <option value="date-asc" selected={defaultSort === "date-asc"}>Oldest first</option>
        <option value="name" selected={defaultSort === "name"}>Name / title</option>
      </select>
    </div>

    <div
      id="filterable-list"
      class="flex flex-col pt-2 mt-2 border-t border-dotted gap-2 border-primary/10"
    >
      {entries.map((e) => (
        <div
          class="filterable-item"
          data-slug={e.slug}
          data-collection={e.collection}
          data-publish-type={e.publishType}
          data-title={e.title.toLowerCase()}
          data-description={e.description.toLowerCase()}
          data-tags={e.tags.join(",")}
          data-publish-date={e.publishDate ?? ""}
        >
          <ContentEntry
            entry={{
              slug: e.slug,
              data: {
                title: e.title,
                description: e.description,
                publish_date: e.publishDate,
                id: e.id,
              },
            }}
            href={entryHref(e.collection, e.slug)}
            collection={e.collection}
            publishType={e.publishType}
          />
        </div>
      ))}
    </div>

    <p id="filterable-no-results" class="hidden mt-4 text-sm text-primary/60">
      No matching entries.
    </p>
    <div id="filterable-list-pagination" class="mt-3 flex items-center justify-between gap-2 text-xs text-primary/70" hidden>
      <button type="button" id="filterable-list-prev" class="rounded px-3 py-1.5 hover:bg-primary/10 disabled:opacity-40 disabled:cursor-not-allowed" aria-label="Previous page">
        ← Prev
      </button>
      <span id="filterable-list-page-status" aria-live="polite"></span>
      <button type="button" id="filterable-list-next" class="rounded px-3 py-1.5 hover:bg-primary/10 disabled:opacity-40 disabled:cursor-not-allowed" aria-label="Next page">
        Next →
      </button>
    </div>
  </div>
</div>

<script define:vars={{ entriesJson: serialized, tagsJson, collectionIdsJson, collectionLabelsJson, initialTagsJson, defaultSortJson: JSON.stringify(defaultSort) }}>
  (function () {
    const TAG_PAGE_SIZE = 30;
    const LIST_PAGE_SIZE = 8;
    const LETTER_RANGES = [
      { id: "all", label: "All", test: () => true },
      { id: "a-f", label: "A–F", test: (t) => /^[a-f]/i.test(t) },
      { id: "g-l", label: "G–L", test: (t) => /^[g-l]/i.test(t) },
      { id: "m-r", label: "M–R", test: (t) => /^[m-r]/i.test(t) },
      { id: "s-z", label: "S–Z", test: (t) => /^[s-z]/i.test(t) },
    ];

    const list = document.getElementById("filterable-list");
    const noResults = document.getElementById("filterable-no-results");
    const searchInput = document.getElementById("filterable-search");
    const sortSelect = document.getElementById("filterable-sort");
    const defaultSort = JSON.parse(defaultSortJson);
    if (sortSelect) sortSelect.value = defaultSort;
    const suggestionsList = document.getElementById("filterable-search-suggestions");
    const listPaginationEl = document.getElementById("filterable-list-pagination");
    const listPrevBtn = document.getElementById("filterable-list-prev");
    const listNextBtn = document.getElementById("filterable-list-next");
    const listPageStatusEl = document.getElementById("filterable-list-page-status");
    const activeTagsContainer = document.getElementById("filterable-active-tags");
    const tagListContainer = document.getElementById("filterable-tag-list");
    const tagSearchInput = document.getElementById("filterable-tag-search");
    const tagRangesContainer = document.getElementById("filterable-tag-ranges");
    const tagEmptyEl = document.getElementById("filterable-tag-empty");
    const tagPaginationEl = document.getElementById("filterable-tag-pagination");
    const tagPrevBtn = document.getElementById("filterable-tag-prev");
    const tagNextBtn = document.getElementById("filterable-tag-next");
    const tagPageStatusEl = document.getElementById("filterable-tag-page-status");
    const root = document.querySelector(".filterable-content");
    const showCollectionFilters = root?.getAttribute("data-show-collection-filters") === "true";

    const entries = JSON.parse(entriesJson);
    const allTags = JSON.parse(tagsJson);
    const collectionIds = JSON.parse(collectionIdsJson);

    let selectedTags = (() => {
      const p = new URLSearchParams(window.location.search);
      const fromUrl = p.getAll("tags").filter(Boolean);
      return fromUrl.length > 0 ? fromUrl : JSON.parse(initialTagsJson);
    })();

    let tagSearchQuery = "";
    let activeLetterRange = "all";
    let tagPage = 1;
    let listPage = 1;

    function getTitle(entry) {
      return entry.title || "";
    }
    function getPublishTime(entry) {
      const d = entry.publishDate;
      return d ? new Date(d).getTime() : 0;
    }

    function getSelectedCollections() {
      if (!showCollectionFilters) return null;
      const checkboxes = document.querySelectorAll(".filterable-collection-checkbox:checked");
      return new Set([...checkboxes].map((cb) => cb.getAttribute("data-collection-id")));
    }

    function updateUrl() {
      const params = new URLSearchParams(window.location.search);
      params.delete("tags");
      selectedTags.forEach((t) => params.append("tags", t));
      const qs = params.toString();
      const url = qs ? `${window.location.pathname}?${qs}` : window.location.pathname;
      window.history.replaceState({}, "", url);
    }

    function escapeHtml(s) {
      const div = document.createElement("div");
      div.textContent = s;
      return div.innerHTML;
    }
    function escapeAttr(s) {
      return escapeHtml(s).replace(/"/g, "&quot;");
    }

    function renderActivePills() {
      if (!activeTagsContainer) return;
      activeTagsContainer.innerHTML = selectedTags
        .map(
          (tag) =>
            `<span class="inline-flex items-center gap-1 rounded-full bg-primary/10 px-2 py-0.5 text-xs text-primary" role="listitem">
              ${escapeHtml(tag)}
              <button type="button" class="filterable-remove-tag -mr-0.5 rounded-full p-0.5 hover:bg-primary/20" data-tag="${escapeAttr(tag)}" aria-label="Remove ${escapeAttr(tag)}">×</button>
            </span>`
        )
        .join("");
      activeTagsContainer.querySelectorAll(".filterable-remove-tag").forEach((btn) => {
        btn.addEventListener("click", () => {
          const t = btn.getAttribute("data-tag");
          if (t) {
            selectedTags = selectedTags.filter((x) => x !== t);
            listPage = 1;
            updateUrl();
            renderActivePills();
            renderTagList();
            apply();
          }
        });
      });
    }

    function getFilteredTags() {
      const q = tagSearchQuery.toLowerCase().trim();
      const range = LETTER_RANGES.find((r) => r.id === activeLetterRange) ?? LETTER_RANGES[0];
      return allTags.filter((tag) => {
        if (q && !tag.toLowerCase().includes(q)) return false;
        if (activeLetterRange === "all") return true;
        const first = tag.trim().charAt(0);
        if (!first) return false;
        if (/^[a-z]/i.test(first)) return range.test(tag);
        return false;
      });
    }

    function renderTagRanges() {
      if (!tagRangesContainer) return;
      tagRangesContainer.innerHTML = LETTER_RANGES.map(
        (r) =>
          `<button type="button" class="filterable-tag-range-btn rounded px-1.5 py-0.5 text-xs cursor-pointer ${
            activeLetterRange === r.id
              ? "bg-accent text-secondary font-medium"
              : "text-primary/70 hover:bg-primary/10"
          }" data-range="${r.id}">${r.label}</button>`
      ).join("");
      tagRangesContainer.querySelectorAll(".filterable-tag-range-btn").forEach((btn) => {
        btn.addEventListener("click", () => {
          const range = btn.getAttribute("data-range");
          if (range && range !== activeLetterRange) {
            activeLetterRange = range;
            tagPage = 1;
            renderTagRanges();
            renderTagList();
          }
        });
      });
    }

    function renderTagPagination(totalPages) {
      if (!tagPaginationEl || !tagPrevBtn || !tagNextBtn || !tagPageStatusEl) return;
      const show = totalPages > 1;
      tagPaginationEl.hidden = !show;
      if (!show) return;
      tagPageStatusEl.textContent = `Page ${tagPage} of ${totalPages}`;
      tagPrevBtn.disabled = tagPage <= 1;
      tagNextBtn.disabled = tagPage >= totalPages;
      tagPrevBtn.setAttribute("aria-disabled", tagPage <= 1 ? "true" : "false");
      tagNextBtn.setAttribute("aria-disabled", tagPage >= totalPages ? "true" : "false");
    }

    function addTagFilter(tag) {
      if (!tag || selectedTags.includes(tag)) return;
      selectedTags = [...selectedTags, tag].sort();
      listPage = 1;
      updateUrl();
      renderActivePills();
      renderTagList();
      apply();
    }

    function renderTagList() {
      if (!tagListContainer) return;
      const filtered = getFilteredTags();
      const totalPages = Math.max(1, Math.ceil(filtered.length / TAG_PAGE_SIZE));
      if (tagPage > totalPages) tagPage = totalPages;
      const start = (tagPage - 1) * TAG_PAGE_SIZE;
      const pageTags = filtered.slice(start, start + TAG_PAGE_SIZE);

      tagListContainer.innerHTML = pageTags
        .map((tag) => {
          const isSelected = selectedTags.includes(tag);
          return `<button type="button" class="filterable-tag-btn text-left text-xs leading-tight break-words cursor-pointer py-0.5 px-1 -mx-1 rounded ${
            isSelected
              ? "font-medium text-accent"
              : "text-primary/70 hover:text-accent"
          }" data-tag="${escapeAttr(tag)}">${escapeHtml(tag)}</button>`;
        })
        .join("");

      tagListContainer.querySelectorAll(".filterable-tag-btn").forEach((btn) => {
        btn.addEventListener("click", () => {
          const tag = btn.getAttribute("data-tag");
          if (tag) addTagFilter(tag);
        });
      });

      if (tagEmptyEl) {
        const empty = filtered.length === 0;
        tagEmptyEl.classList.toggle("hidden", !empty);
        tagListContainer.classList.toggle("hidden", empty);
      }

      renderTagPagination(totalPages);
    }

    function showSuggestions(query) {
      if (!suggestionsList || !searchInput) return;
      const q = (query || "").toLowerCase().trim();
      suggestionsList.innerHTML = "";
      suggestionsList.classList.add("hidden");
      searchInput.setAttribute("aria-expanded", "false");
      if (q.length < 1) return;

      const searchItem = document.createElement("li");
      searchItem.setAttribute("role", "option");
      searchItem.className = "px-3 py-1.5 text-sm text-primary cursor-pointer hover:bg-primary/10";
      searchItem.textContent = `search: "${q}"`;
      searchItem.dataset.action = "search";
      searchItem.dataset.value = q;
      searchItem.addEventListener("click", () => {
        searchInput.value = q;
        suggestionsList.classList.add("hidden");
        searchInput.setAttribute("aria-expanded", "false");
        apply();
      });
      suggestionsList.appendChild(searchItem);

      const matchingTags = allTags.filter((tag) => tag.toLowerCase().includes(q));
      matchingTags.slice(0, 8).forEach((tag) => {
        const li = document.createElement("li");
        li.setAttribute("role", "option");
        li.className = "px-3 py-1.5 text-sm text-primary cursor-pointer hover:bg-primary/10";
        li.textContent = `tag: "${tag}"`;
        li.dataset.action = "tag";
        li.dataset.value = tag;
        li.addEventListener("click", () => {
          addTagFilter(tag);
          searchInput.value = "";
          suggestionsList.classList.add("hidden");
          searchInput.setAttribute("aria-expanded", "false");
        });
        suggestionsList.appendChild(li);
      });

      if (suggestionsList.children.length > 0) {
        suggestionsList.classList.remove("hidden");
        searchInput.setAttribute("aria-expanded", "true");
      }
    }

    function apply() {
      const query = (searchInput?.value ?? "").toLowerCase().trim();
      const sort = sortSelect?.value ?? "date-desc";
      const selectedCollections = getSelectedCollections();

      const items = [...(list?.querySelectorAll(".filterable-item") ?? [])];

      const sortedEntries = [...entries].sort((a, b) => {
        if (sort === "name") return getTitle(a).localeCompare(getTitle(b));
        const ta = getPublishTime(a);
        const tb = getPublishTime(b);
        if (sort === "date-asc") return ta - tb;
        return tb - ta;
      });

      const orderMap = new Map(
        sortedEntries.map((e, i) => [`${e.collection}/${e.slug}`, i])
      );

      // Sort DOM nodes
      const container = list;
      if (container) {
        items.sort((a, b) => {
          const ka = `${a.getAttribute("data-collection")}/${a.getAttribute("data-slug")}`;
          const kb = `${b.getAttribute("data-collection")}/${b.getAttribute("data-slug")}`;
          return (orderMap.get(ka) ?? 0) - (orderMap.get(kb) ?? 0);
        });
        items.forEach((node) => container.appendChild(node));
      }

      // Filter
      const visibleItems = items.filter((el) => {
        const slug = el.getAttribute("data-slug");
        const collection = el.getAttribute("data-collection");
        const title = (el.getAttribute("data-title") ?? "").toLowerCase();
        const description = (el.getAttribute("data-description") ?? "").toLowerCase();
        const tags = (el.getAttribute("data-tags") ?? "").split(",").filter(Boolean);

        const matchesCollection = selectedCollections === null || selectedCollections.has(collection);
        const matchesTags =
          selectedTags.length === 0 ||
          selectedTags.every((t) => tags.some((tag) => tag.trim().toLowerCase() === t.toLowerCase()));
        const matchesSearch =
          !query || title.includes(query) || description.includes(query);

        return matchesCollection && matchesTags && matchesSearch;
      });

      // Paginate
      const totalPages = Math.max(1, Math.ceil(visibleItems.length / LIST_PAGE_SIZE));
      if (listPage > totalPages) listPage = totalPages;
      const start = (listPage - 1) * LIST_PAGE_SIZE;
      const end = start + LIST_PAGE_SIZE;

      // Show/hide items
      items.forEach((el) => {
        const isVisible = visibleItems.includes(el);
        const idx = visibleItems.indexOf(el);
        const onPage = isVisible && idx >= start && idx < end;
        el.classList.toggle("hidden", !onPage);
      });

      // Update pagination UI
      if (listPaginationEl && listPrevBtn && listNextBtn && listPageStatusEl) {
        const showPagination = totalPages > 1;
        listPaginationEl.hidden = !showPagination;
        if (showPagination) {
          listPageStatusEl.textContent = `Page ${listPage} of ${totalPages}`;
          listPrevBtn.disabled = listPage <= 1;
          listNextBtn.disabled = listPage >= totalPages;
        }
      }

      if (noResults) noResults.classList.toggle("hidden", visibleItems.length > 0);

      // Notify rough-notation to re-annotate newly visible elements
      document.dispatchEvent(new CustomEvent("filterable:page-change"));
    }

    searchInput?.addEventListener("input", () => {
      listPage = 1;
      showSuggestions(searchInput.value);
      apply();
    });
    searchInput?.addEventListener("focus", () => {
      if (searchInput.value.trim()) showSuggestions(searchInput.value);
    });
    searchInput?.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        suggestionsList?.classList.add("hidden");
        searchInput?.setAttribute("aria-expanded", "false");
      }
    });
    document.addEventListener("click", (e) => {
      if (suggestionsList && !suggestionsList.contains(e.target) && e.target !== searchInput) {
        suggestionsList.classList.add("hidden");
        searchInput?.setAttribute("aria-expanded", "false");
      }
    });
    sortSelect?.addEventListener("change", () => {
      listPage = 1;
      apply();
    });

    tagSearchInput?.addEventListener("input", () => {
      tagSearchQuery = tagSearchInput.value;
      tagPage = 1;
      renderTagList();
    });

    tagPrevBtn?.addEventListener("click", () => {
      if (tagPage > 1) {
        tagPage--;
        renderTagList();
      }
    });

    tagNextBtn?.addEventListener("click", () => {
      const filtered = getFilteredTags();
      const totalPages = Math.max(1, Math.ceil(filtered.length / TAG_PAGE_SIZE));
      if (tagPage < totalPages) {
        tagPage++;
        renderTagList();
      }
    });

    listPrevBtn?.addEventListener("click", () => {
      if (listPage > 1) {
        listPage--;
        apply();
      }
    });

    listNextBtn?.addEventListener("click", () => {
      listPage++;
      apply();
    });

    if (showCollectionFilters) {
      document.querySelectorAll(".filterable-collection-checkbox").forEach((cb) => {
        cb.addEventListener("change", apply);
      });
    }

    renderTagRanges();
    renderActivePills();
    renderTagList();
    apply();
  })();
</script>
