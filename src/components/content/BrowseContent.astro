---
import FilterableContentLayout from "./FilterableContentLayout.astro";
import type { IndexEntry } from "./FilterableContentLayout.astro";

interface Props {
  entries: IndexEntry[];
  title: string;
  description: string;
  initialTags?: string[];
}

const { entries, title, description, initialTags = [] } = Astro.props;
---

<FilterableContentLayout
  entries={entries}
  title={title}
  description={description}
  initialTags={initialTags}
  showCollectionFilters={true}
/>
