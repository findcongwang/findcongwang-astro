---
// PagedViewer — Detects ?format=print|slides and activates Paged.js rendering
interface Props {
  title?: string;
  subtitle?: string;
  author?: string;
  date?: string;
  type?: string;
}
const { title, subtitle, author, date, type } = Astro.props;
---

<!-- Print-mode header (hidden by default, shown when paged-mode activates) -->
<div class="print-header hidden" id="print-header" data-title={title} data-subtitle={subtitle} data-author={author} data-date={date} data-type={type}>
</div>

<script>
  import { bootPagedViewer } from "./paged-viewer-boot";
  bootPagedViewer();
</script>
