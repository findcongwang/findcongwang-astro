---
// PageBreak — forces a page break in print mode
// type="chapter" — starts new page with extra top spacing (chapter start feel in web view)
// type="section" (default) — starts new page, zero visual footprint
interface Props {
  type?: 'chapter' | 'section';
}
const { type = 'section' } = Astro.props;
const className = type === 'chapter' ? 'chapter-break' : 'page-break';
const style = type === 'chapter'
  ? 'border-top: 1px dashed rgba(0,0,0,0.05); margin: 3em 0;'
  : 'margin: 0; padding: 0; height: 0;';
---

<div class={className} style={style}></div>
