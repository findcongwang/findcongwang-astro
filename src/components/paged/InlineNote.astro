---
import type { SemanticColour } from "@/utils/annotation-colours";
import { resolveColourStyle } from "@/utils/annotation-colours";

interface Props {
  reading: string;
  color?: SemanticColour | string;
}

const { reading, color } = Astro.props;

const rtColor = color
  ? typeof color === "string" && color.startsWith("#")
    ? color
    : resolveColourStyle({ palette: "semantic", color: (color as SemanticColour) ?? "green" })
  : "#777";
---

<ruby class="inline-note" style={`--inline-note-color: ${rtColor};`}>
  <slot /><rp>(</rp><rt>{reading}</rt><rp>)</rp>
</ruby>

<style is:global>
  ruby.inline-note {
    ruby-position: over;
    ruby-align: center;
    margin-top: 0.65em;
    vertical-align: baseline;
  }

  ruby.inline-note rt {
    color: var(--inline-note-color, #777);
    font-family: Geist, sans-serif;
    font-size: 0.55em;
    font-style: italic;
    line-height: 1.1;
    white-space: nowrap;
    letter-spacing: -0.01em;
  }
</style>
