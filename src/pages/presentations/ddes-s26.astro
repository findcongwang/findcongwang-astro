---
import "@/components/gestalt/gestalt.css";
import "@/components/fw-vision/fw-vision.css";
import { GestaltPresentation } from "@/components/gestalt/GestaltPresentation";
import { ddesS26Data } from "@/components/gestalt/data/ddes-s26";

function parseSlideIndex(search: string, maxSteps: number): number {
  const params = new URLSearchParams(search);
  const raw = params.get("slide") ?? params.get("step");
  if (raw === null) return 0;
  const n = parseInt(raw, 10);
  if (isNaN(n)) return 0;
  return Math.max(0, Math.min(n, Math.max(0, maxSteps - 1)));
}

const initialSlideIndex = parseSlideIndex(Astro.url.search, ddesS26Data.storyline.length);
---
<html lang="en" data-theme="light">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{ddesS26Data.title} — Presentation</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@100..900&family=Geist:wght@100..900&family=Newsreader:ital,opsz,wght@0,6..72,200..800;1,6..72,200..800&display=swap" rel="stylesheet" />
  <style>
    * { box-sizing: border-box; }
    html, body { margin: 0; padding: 0; overflow: hidden; width: 100vw; height: 100vh; }
    body { background: var(--gestalt-bg, #f8f8fa); font-family: 'Geist', sans-serif; }
  </style>
</head>
<body>
  <GestaltPresentation client:load data={ddesS26Data} initialSlideIndex={initialSlideIndex} />
</body>
</html>
