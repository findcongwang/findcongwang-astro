---
import "@/components/gestalt/gestalt.css";
import "@/components/fw-vision/fw-vision.css";
import { GestaltPresentation } from "@/components/gestalt/GestaltPresentation";
import { ddesS26Data } from "@/components/gestalt/data/ddes-s26";

function parseSlideIndex(search: string): { slideIndex: number | null; storyIndex: number | null } {
  const params = new URLSearchParams(search);
  const slideRaw = params.get("slide");
  const storyRaw = params.get("story");
  
  let slideIndex: number | null = null;
  let storyIndex: number | null = null;
  
  if (slideRaw !== null) {
    const n = parseInt(slideRaw, 10);
    if (!isNaN(n)) slideIndex = n;
  }
  
  if (storyRaw !== null) {
    const n = parseInt(storyRaw, 10);
    if (!isNaN(n)) storyIndex = n;
  }
  
  return { slideIndex, storyIndex };
}

const { slideIndex, storyIndex } = parseSlideIndex(Astro.url.search);
---
<html lang="en" data-theme="light">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{ddesS26Data.title} — Presentation</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@100..900&family=Geist:wght@100..900&family=Newsreader:ital,opsz,wght@0,6..72,200..800;1,6..72,200..800&display=swap" rel="stylesheet" />
  <style>
    * { box-sizing: border-box; }
    html, body { margin: 0; padding: 0; overflow: hidden; width: 100vw; height: 100vh; }
    body { background: var(--gestalt-bg, #f8f8fa); font-family: 'Geist', sans-serif; }
  </style>
</head>
<body>
  <GestaltPresentation client:load data={ddesS26Data} initialSlideIndex={slideIndex ?? 0} initialStoryIndex={storyIndex ?? 0} />
</body>
</html>
