---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
---

<BaseLayout title="Presentations" description="Interactive dual-track presentation decks." noindex={true}>
  <section>
    <Wrapper variant="standard" class="pt-24 pb-12 lg:pt-48">
      <header class="mb-12">
        <h1 class="text-2xl md:text-3xl font-serif font-medium text-primary mb-3">Presentations</h1>
        <p class="text-sm text-primary/60 max-w-xl">Interactive dual-track presentations. Navigate slides with left/right arrows. Where available, advance the story track with up/down arrows.</p>
      </header>

      <div class="space-y-4">
        <a href="/presentations/ddes-s26/" class="block group">
          <article class="p-5 border border-primary/10 rounded-lg transition-colors group-hover:border-primary/20 group-hover:bg-primary/[0.01]">
            <div class="flex items-baseline justify-between gap-4">
              <h2 class="text-base font-serif font-medium text-primary group-hover:underline">Designing Innovation</h2>
              <time class="text-xs font-mono text-primary/40 shrink-0">Jun 2026</time>
            </div>
            <p class="text-sm text-primary/60 mt-1.5">Cultivating Communities for Foresight-Driven Societal Resilience. DDes Spring Symposium, University of Calgary.</p>
          </article>
        </a>

        <a href="/presentations/libraries-of-the-future/" class="block group">
          <article class="p-5 border border-primary/10 rounded-lg transition-colors group-hover:border-primary/20 group-hover:bg-primary/[0.01] relative">
            <span class="absolute top-4 right-4 text-xs font-mono text-primary/30" aria-label="Passcode required">&#x1f512;</span>
            <div class="flex items-baseline justify-between gap-4 pr-8">
              <h2 class="text-base font-serif font-medium text-primary group-hover:underline">Libraries of the Future</h2>
              <time class="text-xs font-mono text-primary/40 shrink-0">2026</time>
            </div>
            <p class="text-sm text-primary/60 mt-1.5">Book proposal pitch. Hybrid Intelligence and Knowledge Integration in the Post-Agentic World.</p>
          </article>
        </a>
      </div>
    </Wrapper>
  </section>
</BaseLayout>
