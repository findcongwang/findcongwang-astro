  <script is:inline>
    (function() {
      var lock = document.getElementById('lock-screen');
      var content = document.getElementById('main-content');
      var form = document.getElementById('passcode-form');
      var input = document.getElementById('passcode-input');
      var errorMsg = document.getElementById('error-msg');

      function unlock() {
        lock.style.display = 'none';
        content.style.display = 'block';
      }

      // Check URL param
      var params = new URLSearchParams(window.location.search);
      var key = params.get('key');
      if (key && key.toUpperCase() === 'FUTUREGGU') {
        unlock();
      }

      // Handle form
      form.addEventListener('submit', function(e) {
        e.preventDefault();
        if (input.value.toUpperCase() === 'FUTUREGGU') {
          unlock();
        } else {
          errorMsg.classList.remove('hidden');
          input.value = '';
          setTimeout(function() { errorMsg.classList.add('hidden'); }, 3000);
        }
      });
    })();
  </script>
