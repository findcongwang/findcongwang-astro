---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import FilterableContentLayout from "@/components/content/FilterableContentLayout.astro";
import { getListableEntries, toIndexEntries } from "@/utils/content";

const listable = await getListableEntries("posts");
const entries = toIndexEntries("posts", listable);
const sorted = [...entries].sort((a, b) => {
  const da = a.publishDate ? new Date(a.publishDate).getTime() : 0;
  const db = b.publishDate ? new Date(b.publishDate).getTime() : 0;
  return db - da;
});
const initialTags = Astro.url.searchParams.getAll("tags").filter(Boolean);
---

<BaseLayout title="Posts" description="Ideas, insights & experiments.">
  <section>
    <Wrapper variant="standard" class="pt-24 pb-12 lg:pt-48">
      <FilterableContentLayout
        entries={sorted}
        title="Posts"
        description="Ideas, insights & experiments."
        initialTags={initialTags}
      />
    </Wrapper>
  </section>
</BaseLayout>
