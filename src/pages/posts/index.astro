---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import ContentIndex from "@/components/content/ContentIndex.astro";
import Subscribe from "@/components/blog/Subscribe.astro";
import { getListableEntries, toIndexEntries } from "@/utils/content";

const listable = await getListableEntries("posts");
const entries = toIndexEntries("posts", listable);
const sorted = [...entries].sort((a, b) => {
  const da = a.publishDate ? new Date(a.publishDate).getTime() : 0;
  const db = b.publishDate ? new Date(b.publishDate).getTime() : 0;
  return db - da;
});
---

<BaseLayout>
  <section>
    <Wrapper variant="standard" class="pt-24 pb-12 lg:pt-48">
      <ContentIndex
        entries={sorted}
        title="Posts"
        description="Ideas, insights & experiments."
      />
    </Wrapper>
  </section>
  <Subscribe />
</BaseLayout>
