---
import "@/components/gestalt/gestalt.css";
import { GestaltExplorer } from "@/components/gestalt/GestaltExplorer";
import { ddesS26Data } from "@/components/gestalt/data/ddes-s26";
---
<html lang="en" data-theme="light">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Emergence — {ddesS26Data.title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@100..900&family=Geist:wght@100..900&family=Newsreader:ital,opsz,wght@0,6..72,200..800;1,6..72,200..800&display=swap" rel="stylesheet" />
  <style>
    * { box-sizing: border-box; }
    html, body { margin: 0; padding: 0; overflow: hidden; width: 100vw; height: 100vh; }
    body { background: #f8f8fa; font-family: 'Geist', sans-serif; }
  </style>
</head>
<body>
  <GestaltExplorer client:load data={ddesS26Data} />
</body>
</html>
