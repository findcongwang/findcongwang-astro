---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import FilterableContentLayout from "@/components/content/FilterableContentLayout.astro";
import { getListableEntries, toIndexEntries } from "@/utils/content";

const listable = await getListableEntries("domains");
const entries = toIndexEntries("domains", listable);
const sorted = [...entries].sort((a, b) =>
  a.title.localeCompare(b.title)
);
const initialTags = Astro.url.searchParams.getAll("tags").filter(Boolean);
---

<BaseLayout title="Domains" description="Atlas-level overviews of how I organize my thinking across topics.">
  <section>
    <Wrapper variant="standard" class="pt-24 pb-12 lg:pt-48">
      <FilterableContentLayout
        entries={sorted}
        title="Domains"
        description="Domains are how I organize my thinking, these notes are atlas-level overviews. Sometimes, a topic crosses multiple domains at different levels of abstraction."
        initialTags={initialTags}
      />
    </Wrapper>
  </section>
</BaseLayout>
