---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import FilterableContentLayout from "@/components/content/FilterableContentLayout.astro";
import { getListableEntries, toIndexEntries } from "@/utils/content";

const listable = await getListableEntries("lexicon");
const entries = toIndexEntries("lexicon", listable);
const sorted = [...entries].sort((a, b) => a.title.localeCompare(b.title));
const initialTags = Astro.url.searchParams.getAll("tags").filter(Boolean);
---

<BaseLayout title="Lexicon" description="Key terms, concepts, and distinctions I use to think about the world.">
  <section>
    <Wrapper variant="standard" class="pt-24 pb-12 lg:pt-48">
      <FilterableContentLayout
        entries={sorted}
        title="Lexicon"
        description="Key terms and concepts that I use to think about the world."
        initialTags={initialTags}
        defaultSort="name"
      />
    </Wrapper>
  </section>
</BaseLayout>
