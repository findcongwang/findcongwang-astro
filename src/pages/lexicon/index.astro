---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import ContentIndex from "@/components/content/ContentIndex.astro";
import { getListableEntries, toIndexEntries } from "@/utils/content";

const listable = await getListableEntries("lexicon");
const entries = toIndexEntries("lexicon", listable);
const sorted = [...entries].sort((a, b) => a.title.localeCompare(b.title));
---

<BaseLayout>
  <section>
    <Wrapper variant="standard" class="pt-24 pb-12 lg:pt-48">
      <ContentIndex
        entries={sorted}
        title="Lexicon"
        description="A set of key terms, concepts, and distinctions that I use to think about the world."
      />
    </Wrapper>
  </section>
</BaseLayout>
