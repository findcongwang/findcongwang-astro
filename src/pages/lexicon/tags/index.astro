---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import TagsIndex from "@/components/content/TagsIndex.astro";
import { getTagsIndexProps } from "@/utils/tagPages";

const props = await getTagsIndexProps("lexicon");
---

<BaseLayout>
  <section>
    <Wrapper variant="standard" class="pt-24 pb-12 lg:pt-48">
      <TagsIndex {...props} />
    </Wrapper>
  </section>
</BaseLayout>
