---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import TagPageContent from "@/components/content/TagPageContent.astro";
import { getTagPageStaticPaths } from "@/utils/tagPages";

export const getStaticPaths = () => getTagPageStaticPaths("influences");

const { tag, entries, allTags, basePath } = Astro.props;
---

<BaseLayout pageTitle={tag}>
  <section>
    <Wrapper variant="standard" class="pt-24 pb-12 lg:pt-48">
      <TagPageContent tag={tag} entries={entries} allTags={allTags} basePath={basePath} />
    </Wrapper>
  </section>
</BaseLayout>
