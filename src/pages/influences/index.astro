---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import FilterableContentLayout from "@/components/content/FilterableContentLayout.astro";
import { getListableEntries, toIndexEntries } from "@/utils/content";

const listable = await getListableEntries("influences");
const entries = toIndexEntries("influences", listable);
const sorted = [...entries].sort((a, b) => a.title.localeCompare(b.title));
const initialTags = Astro.url.searchParams.getAll("tags").filter(Boolean);
---

<BaseLayout>
  <section>
    <Wrapper variant="standard" class="pt-24 pb-12 lg:pt-48">
      <FilterableContentLayout
        entries={sorted}
        title="Influences and Precedents"
        description="A list of people, books, patterns, and ideas that have influenced my work and thinking."
        initialTags={initialTags}
      />
    </Wrapper>
  </section>
</BaseLayout>
