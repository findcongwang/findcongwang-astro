---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import ContentIndex from "@/components/content/ContentIndex.astro";
import { getListableEntries, toIndexEntries } from "@/utils/content";

const listable = await getListableEntries("projects");
const entries = toIndexEntries("projects", listable);
const sorted = [...entries].sort((a, b) => {
  const da = a.publishDate ? new Date(a.publishDate).getTime() : 0;
  const db = b.publishDate ? new Date(b.publishDate).getTime() : 0;
  return db - da;
});
---

<BaseLayout>
  <section>
    <Wrapper variant="standard" class="pt-24 pb-12 lg:pt-48">
      <ContentIndex
        entries={sorted}
        title="Projects"
        description="Books, research initiatives, and other work."
      />
    </Wrapper>
  </section>
</BaseLayout>
